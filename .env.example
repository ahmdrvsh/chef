# .env.example
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# MySQL Database (Self-Hosted on cPanel / VPS)
MYSQL_URL=mysql://username:password@localhost:3306/sofreh_db

# Redis Cache & Sessions (Optional - falls back to In-Memory Cache if empty)
REDIS_URL=

# Object Storage / S3 (Optional - falls back to local /uploads folder if empty)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1


